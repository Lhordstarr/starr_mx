{
  "name": "local-online-llm-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web chat UI that streams from local Ollama and online LLM providers",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "desktop": "electron desktop/main.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:stt": "tsx scripts/stt-selftest.ts",
    "test:stt-local": "tsx scripts/stt-local-selftest.ts",
    "test:attachments": "tsx scripts/attachments-selftest.ts",
    "test:tools": "tsx scripts/tools-selftest.ts",
    "test:ui-tools": "node scripts/ui-tools-selftest.mjs",
    "test:ollama-models": "tsx scripts/ollama-models-selftest.ts",
    "test:processes": "tsx scripts/processes-selftest.ts",
    "test:process-poll": "node scripts/process-poll-selftest.mjs",
    "test:hf": "tsx scripts/hf-selftest.ts",
    "test:providers": "tsx scripts/providers-selftest.ts",
    "test:speaker-ui": "node scripts/speaker-ui-selftest.mjs",
    "test:runnable": "tsx scripts/runnable-selftest.ts",
    "test:runtimes": "tsx scripts/runtimes-selftest.ts",
    "test:whisper": "tsx scripts/whisper-selftest.ts",
    "test:tts": "tsx scripts/tts-selftest.ts",
    "test:llamacpp": "tsx scripts/llamacpp-selftest.ts",
    "test:llamacpp-ui": "node scripts/llamacpp-ui-selftest.mjs",
    "test:models-ui": "node scripts/models-row-ui-selftest.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.18",
    "@langchain/ollama": "^1.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "electron": "^44.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
