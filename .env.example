# Copy to .env and adjust as needed.

# ---- Server ----
PORT=3000
# Loopback only. Set to 0.0.0.0 to expose on your network (see README security).
HOST=127.0.0.1

# Serve HTTPS directly with a certificate+key. Without these, set a reverse
# proxy (Caddy/nginx) in front of the app and terminate TLS there.
# TLS_CERT=./cert.pem
# TLS_KEY=./key.pem
# Set when running behind a proxy so rate limiting sees real client IPs.
# TRUST_PROXY=1

# ---- Limits ----
# There is no login. These are what stand between a runaway loop and your
# API credits, so leave them on if you expose the port.
# RATE_LIMIT_PER_MINUTE=30
# MAX_CONCURRENT_STREAMS=4

# Where providers you add on the settings page are stored (default:
# .providers.json beside the app).
# CUSTOM_PROVIDERS_FILE=./.providers.json

# ---- Providers ----
OLLAMA_BASE_URL=http://localhost:11434

# Point OpenAI or Groq at a proxy or self-hosted gateway instead of the default.
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# API keys may be set here or on the /settings page. The settings page wins.
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...

# Where the settings page stores keys (default: .keys.json beside the app).
# KEYS_FILE=./.keys.json